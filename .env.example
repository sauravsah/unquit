# ---------------------------------------------------------------------------
# Unquit environment variables
# Copy this file to `.env.local` for local development, and add the same
# names + values in Vercel → Project → Settings → Environment Variables.
# NEVER commit real values. All values below are placeholders.
# ---------------------------------------------------------------------------

# Postgres on Neon. On Vercel, add the Neon integration (Storage → Neon): it sets
# DATABASE_URL (pooled), DATABASE_URL_UNPOOLED (direct) and POSTGRES_URL for you.
# Locally, copy them from Neon → your project → Connection details.
# The app uses DATABASE_URL (falls back to POSTGRES_URL); `npm run db:migrate`
# prefers DATABASE_URL_UNPOOLED.
DATABASE_URL=postgresql://user:password@ep-example-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Auth.js (email + password sign-in). Secret! Signs and encrypts session cookies.
# Generate one with: openssl rand -base64 32   (NEXTAUTH_SECRET is accepted too)
AUTH_SECRET=replace-with-a-long-random-string
# OPTIONAL. The app's public URL for Auth.js. Defaults to NEXT_PUBLIC_APP_URL (below),
# and on Vercel to the deployment URL. AUTH_URL works as an alias.
# NEXTAUTH_URL=http://localhost:3000

# Stripe (your PLATFORM account, test mode first) → Developers → API keys
STRIPE_SECRET_KEY=sk_test_replace_me
# Stripe → Developers → API keys → Publishable key (public; used by the card-update page)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# Stripe → Settings → Connect → Onboarding options → OAuth → "Test mode client ID" (starts with ca_)
STRIPE_CONNECT_CLIENT_ID=ca_replace_me
# Stripe → Developers → Webhooks → your "Connected accounts" endpoint → Signing secret (starts with whsec_)
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# OPTIONAL. A second endpoint for "Events on your account" (unquit's own invoices + Checkout),
# pointing at /api/stripe/platform-webhook. Leave empty to skip it.
STRIPE_PLATFORM_WEBHOOK_SECRET=

# Resend → API Keys. Leave empty to log emails instead of sending them.
RESEND_API_KEY=
# The "from" address for dunning emails, on a domain verified in Resend.
# Customers see the founder's company name as the sender name.
EMAIL_FROM_ADDRESS=billing@mail.yourdomain.com

# Make these two up: long random strings, at least 32 characters, different from each other
# (and from AUTH_SECRET).
# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" to /api/cron/dunning.
CRON_SECRET=replace-with-a-long-random-string
# Signs the card-update links in dunning emails. Changing it breaks links already sent.
DUNNING_LINK_SECRET=replace-with-another-long-random-string

# Sign-in emails allowed into /admin (the dispute review queue), comma-separated.
ADMIN_EMAILS=you@yourdomain.com
# OPTIONAL. Days a pending cancel save waits for its first paid invoice before it's lost (default 45).
# VERIFY_WINDOW_DAYS=45

# The public address of the app, no trailing slash.
# Local: http://localhost:3000   Vercel: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
